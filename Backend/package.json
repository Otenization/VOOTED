{
  "name": "vooted-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:reset-seed": "node database/scripts/reset_and_seed_mock_data.js",
    "build:server": "node build.cjs",
    "package": "node build.cjs && pkg dist-server/bundle.cjs -c package.json --targets node20-win-x64 --output ../Release/VOOTED.exe",
    "build:all": "node build-multi-platform.cjs --all",
    "build:windows": "node build-multi-platform.cjs --target win64",
    "build:linux": "node build-multi-platform.cjs --target linux-x64",
    "build:linux-arm": "node build-multi-platform.cjs --target linux-arm64"
  },
  "pkg": {
    "assets": [
      "public/dist/**/*"
    ],
    "scripts": []
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "VOOTED backend API for local YouTube VOD queueing and runtime control",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.1.0",
    "iso-639-1": "^3.1.5",
    "node-cron": "^4.2.1",
    "pg": "^8.19.0",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.19.0",
    "esbuild": "^0.28.0"
  }
}
